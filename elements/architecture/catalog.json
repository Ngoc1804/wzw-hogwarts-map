{
  "version": "2.0.0",
  "status": "adjustable indoor formulas; no furniture; fixed wall elevation",
  "units": "design-unit",
  "projection": {
    "wallHeight": 36,
    "wallThickness": 16,
    "sideOffsetPerHeight": 0.35,
    "wallHeightEditable": false
  },
  "elements": [
    {
      "id": "architecture.floor",
      "module": "elements.mjs",
      "export": "path",
      "geometry": "closed plan polygon",
      "ports": "declared by recipe"
    },
    {
      "id": "architecture.wall-horizontal",
      "module": "elements.mjs",
      "export": "hwall",
      "parameters": [
        "x1",
        "x2",
        "y",
        "z",
        "t"
      ],
      "ports": [
        "start",
        "end"
      ],
      "footprint": "describeWall"
    },
    {
      "id": "architecture.wall-vertical",
      "module": "elements.mjs",
      "export": "vwall",
      "parameters": [
        "x",
        "y1",
        "y2",
        "z",
        "t"
      ],
      "ports": [
        "start",
        "end"
      ],
      "footprint": "describeWall"
    },
    {
      "id": "architecture.wall-angled",
      "module": "elements.mjs",
      "export": "angledWall",
      "parameters": [
        "a",
        "b",
        "z"
      ],
      "ports": [
        "start",
        "end"
      ],
      "footprint": "describeWall",
      "note": "Curves are tessellated into angled segments by recipes."
    },
    {
      "id": "architecture.door-arch",
      "module": "elements.mjs",
      "export": "arch",
      "parameters": [
        "x",
        "y",
        "z"
      ],
      "clearOpeningWidth": 38,
      "recipeWallGapWidth": 50
    },
    {
      "id": "architecture.door-threshold",
      "module": "elements.mjs",
      "export": "lowdoor",
      "parameters": [
        "x",
        "y",
        "z"
      ],
      "clearOpeningWidth": 38
    },
    {
      "id": "architecture.window-lancet",
      "module": "elements.mjs",
      "export": "lancet",
      "parameters": [
        "x",
        "y",
        "z"
      ],
      "placement": "wall with verified outside/courtyard exposure"
    }
  ],
  "recipes": [
    "horizontal",
    "vertical",
    "ell",
    "tee",
    "cross",
    "court",
    "cloister",
    "windows",
    "curved",
    "tower"
  ],
  "selectionPolicy": {
    "priority": [
      "knownStructure",
      "explicitOrConstraintSelection",
      "explicitlyAllowedRandom"
    ],
    "implemented": true,
    "entryPoint": "selectIndoorFormula",
    "note": "Receives caller constraints only; does not read or edit atlas."
  }
}
