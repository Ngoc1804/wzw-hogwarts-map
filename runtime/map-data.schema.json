{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizamap.local/map-data-v4.schema.json",
  "title": "WIZAMAP MAP_DATA V4",
  "type": "object",
  "additionalProperties": true,
  "$comment": "Semantic public input. Normalizer is tolerant; schema diagnostics never block an entire render. Legacy input is adapted by map-data.mjs.",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "default": "4.0.0"
    },
    "meta": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "areaName": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "mapMode": {
      "enum": [
        "template",
        "indoor",
        "outdoor"
      ]
    },
    "atlasAnchor": {
      "type": "string",
      "description": "Existing canonical place ID, exact group key, template ID, unambiguous Atlas name or custom."
    },
    "layoutType": {
      "type": "string",
      "description": "Optional illustrative layout; Gemini takes precedence over Atlas preset."
    },
    "pcPlace": {
      "type": "string"
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "default": []
    }
  },
  "$defs": {
    "place": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "description": "Optional disambiguating local ID; SVG IDs are never required."
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "size": {
          "type": [
            "string",
            "number",
            "object"
          ]
        },
        "props": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        }
      },
      "required": [
        "name"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "placeName": {
          "type": "string"
        },
        "houseOrRole": {
          "type": "string"
        },
        "activity": {
          "type": "string"
        },
        "observation": {
          "type": "string"
        },
        "isPC": {
          "type": "boolean"
        },
        "stance": {
          "enum": [
            "idle",
            "walk"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string"
        },
        "placeName": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ]
    }
  }
}
