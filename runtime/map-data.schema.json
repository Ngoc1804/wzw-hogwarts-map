{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wizawi:wizamap:map-data:3.0.0",
  "title": "WIZAMAP MAP_DATA 3.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "3.0.0",
      "default": "3.0.0"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "areaName": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "maxLength": 180,
          "default": ""
        }
      },
      "required": [
        "date",
        "time",
        "areaName"
      ]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scopeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "preferredMode": {
          "type": "string",
          "enum": [
            "auto",
            "template",
            "generated"
          ],
          "default": "auto"
        },
        "templateId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "default": null
        },
        "routePlaceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "uniqueItems": true,
          "default": []
        },
        "crop": {
          "type": "boolean",
          "default": true
        },
        "spatial": {
          "$ref": "#/$defs/spatial"
        },
        "indoor": {
          "$ref": "#/$defs/indoor"
        },
        "selectedId": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [],
      "default": {}
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      },
      "minItems": 1
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "doorway",
              "corridor",
              "stairs",
              "lift",
              "path",
              "passage",
              "transport"
            ],
            "default": "doorway"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "restricted",
              "blocked"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "state"
        ]
      },
      "maxItems": 60,
      "default": []
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      },
      "minItems": 1,
      "maxItems": 11
    },
    "hints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hint"
      },
      "maxItems": 5,
      "default": []
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fogRegionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "uniqueItems": true,
          "maxItems": 30,
          "default": []
        },
        "fogRegions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "points": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "$ref": "#/$defs/point"
                }
              }
            },
            "required": [
              "id",
              "points"
            ]
          }
        }
      },
      "required": [],
      "default": {}
    }
  },
  "required": [
    "meta",
    "places",
    "actors"
  ],
  "$defs": {
    "place": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "atlasRef": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "default": null
        },
        "kind": {
          "type": "string",
          "enum": [
            "room",
            "corridor",
            "hall",
            "tower",
            "house",
            "shop",
            "pub",
            "greenhouse",
            "grounds",
            "street",
            "region",
            "train",
            "special"
          ]
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "default": null
        },
        "floor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "default": null
        },
        "zone": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "north",
            "east",
            "south",
            "west",
            "core",
            "tower"
          ],
          "default": null
        },
        "inspector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "overhear": {
              "type": "string",
              "maxLength": 700,
              "default": ""
            },
            "observation": {
              "type": "string",
              "maxLength": 1000,
              "default": ""
            }
          },
          "required": [],
          "default": {
            "overhear": "",
            "observation": ""
          }
        },
        "generation": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "function": {
              "type": "string",
              "minLength": 1
            },
            "shape": {
              "type": "string",
              "enum": [
                "rectangle",
                "L",
                "T",
                "U",
                "round",
                "straight",
                "cross"
              ],
              "default": "rectangle"
            },
            "furnishings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                  },
                  "assetId": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "width": {
                    "type": "number",
                    "minimum": 5,
                    "maximum": 500
                  },
                  "depth": {
                    "type": "number",
                    "minimum": 5,
                    "maximum": 500
                  },
                  "rotation": {
                    "type": "number",
                    "minimum": -360,
                    "maximum": 360
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "placement": {
                    "enum": [
                      "auto",
                      "center",
                      "rows",
                      "wall-north",
                      "wall-south",
                      "wall-east",
                      "wall-west"
                    ]
                  },
                  "position": {
                    "$ref": "#/$defs/point"
                  },
                  "on": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "blocking": {
                    "type": "boolean"
                  },
                  "custom": {
                    "$ref": "#/$defs/customAsset"
                  },
                  "near": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "nearOffset": {
                    "$ref": "#/$defs/point"
                  }
                },
                "required": [
                  "role",
                  "count"
                ]
              },
              "maxItems": 30,
              "default": []
            },
            "width": {
              "type": "number",
              "minimum": 180,
              "maximum": 560
            },
            "depth": {
              "type": "number",
              "minimum": 180,
              "maximum": 520
            },
            "furnishingsMode": {
              "enum": [
                "replace",
                "add"
              ]
            },
            "floorMaterial": {
              "enum": [
                "stone",
                "wood",
                "tile"
              ]
            },
            "floorColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "function"
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "isPC": {
          "type": "boolean",
          "default": false
        },
        "entityType": {
          "type": "string",
          "enum": [
            "person",
            "group",
            "community",
            "creature"
          ],
          "default": "person"
        },
        "placeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "tagType": {
          "type": "string",
          "enum": [
            "gryffindor",
            "slytherin",
            "ravenclaw",
            "hufflepuff",
            "beauxbatons",
            "durmstrang",
            "teacher",
            "adult",
            "patrol",
            "animal",
            "monster",
            "ghost",
            "unknown",
            "crowd"
          ],
          "default": "unknown"
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "default": null
        },
        "onPatrol": {
          "type": "boolean",
          "default": false
        },
        "stance": {
          "type": "string",
          "enum": [
            "idle",
            "walk"
          ],
          "default": "idle"
        },
        "activity": {
          "type": "string",
          "maxLength": 500,
          "default": ""
        },
        "positionMode": {
          "type": "string",
          "enum": [
            "normal",
            "ghost",
            "concealed-passage",
            "animagus",
            "inside-container"
          ],
          "default": "normal"
        },
        "positionReason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "default": null
        },
        "inspector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "overhear": {
              "type": "string",
              "maxLength": 700,
              "default": ""
            },
            "observation": {
              "type": "string",
              "maxLength": 1000,
              "default": ""
            }
          },
          "required": [],
          "default": {
            "overhear": "",
            "observation": ""
          }
        },
        "environment": {
          "type": "string",
          "enum": [
            "inside",
            "outside"
          ]
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "buildingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "name",
        "placeId"
      ]
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "placeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "side",
            "hint",
            "pool",
            "life"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "inspector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "overhear": {
              "type": "string",
              "maxLength": 700,
              "default": ""
            },
            "observation": {
              "type": "string",
              "maxLength": 1000,
              "default": ""
            }
          },
          "required": [],
          "default": {
            "overhear": "",
            "observation": ""
          }
        }
      },
      "required": [
        "id",
        "placeId",
        "type",
        "title"
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "walkableRegions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          }
        },
        "blockedRegions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          }
        },
        "occlusionRegions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "targetId": {
                "type": "string",
                "minLength": 1
              },
              "points": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "$ref": "#/$defs/point"
                }
              },
              "interactiveId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "targetId",
              "points"
            ]
          }
        }
      },
      "required": [
        "walkableRegions",
        "blockedRegions",
        "occlusionRegions"
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      },
      "required": [
        "id",
        "points"
      ]
    },
    "indoor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "type": "string",
          "enum": [
            "auto",
            "horizontal",
            "vertical",
            "ell",
            "tee",
            "cross",
            "court",
            "cloister",
            "windows",
            "curved",
            "tower"
          ]
        },
        "knownStructure": {
          "type": "string",
          "enum": [
            "horizontal",
            "vertical",
            "ell",
            "tee",
            "cross",
            "court",
            "cloister",
            "windows",
            "curved",
            "tower"
          ]
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "courtyard": {
              "type": "string",
              "enum": [
                "open",
                "closed"
              ]
            },
            "windows": {
              "type": "boolean"
            },
            "curved": {
              "type": "boolean"
            },
            "tower": {
              "type": "boolean"
            },
            "branches": {
              "type": "integer",
              "minimum": 2,
              "maximum": 4
            },
            "orientation": {
              "type": "string",
              "enum": [
                "horizontal",
                "vertical"
              ]
            }
          }
        },
        "roomWidth": {
          "type": "number",
          "minimum": 180,
          "maximum": 560
        },
        "roomDepth": {
          "type": "number",
          "minimum": 180,
          "maximum": 520
        },
        "corridorWidth": {
          "type": "number",
          "minimum": 100,
          "maximum": 240
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "horizontal",
              "vertical",
              "ell",
              "tee",
              "cross",
              "court",
              "cloister",
              "windows",
              "curved",
              "tower"
            ]
          }
        },
        "strategy": {
          "type": "string",
          "enum": [
            "constraints",
            "random"
          ]
        },
        "allowRandom": {
          "type": "boolean"
        }
      }
    },
    "customAsset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 2000
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 2000
        },
        "shapes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "rect",
                  "ellipse",
                  "path"
                ]
              },
              "x": {
                "type": "number",
                "minimum": -1000,
                "maximum": 1000
              },
              "y": {
                "type": "number",
                "minimum": -1000,
                "maximum": 1000
              },
              "width": {
                "type": "number",
                "minimum": 1,
                "maximum": 2000
              },
              "height": {
                "type": "number",
                "minimum": 1,
                "maximum": 2000
              },
              "rx": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "ry": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "d": {
                "type": "string",
                "maxLength": 12000,
                "pattern": "^[MmZzLlHhVvCcSsQqTtAaEe0-9.,+ \\n\\r-]+$"
              },
              "fill": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "stroke": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "strokeWidth": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "cx": {
                "type": "number",
                "minimum": -1000,
                "maximum": 2000
              },
              "cy": {
                "type": "number",
                "minimum": -1000,
                "maximum": 2000
              }
            },
            "required": [
              "type",
              "fill"
            ]
          }
        },
        "surface": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 2000
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 2000
            },
            "width": {
              "type": "number",
              "minimum": 0,
              "maximum": 2000
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 2000
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ]
        }
      },
      "required": [
        "width",
        "height",
        "shapes"
      ]
    }
  },
  "$comment": "Demo 2 single public contract. All supplied places are public. PC focus derives from the actor marked isPC. Engine applies presentation defaults only."
}
